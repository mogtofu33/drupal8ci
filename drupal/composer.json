{
    "name": "mog33/drupal8ci",
    "description": "Packages for CI with Drupal used by https://gitlab.com/mog33/gitlab-ci-drupal.",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "edgedesign/phpqa": "^1.27",
        "consolidation/robo": "^5.1",
        "drupal/coder": "^8.3.30",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1.2",
        "phpstan/phpstan": "^1.12.28",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^1.2.1",
        "mglaman/phpstan-drupal": "^1.3.9",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "pdepend/pdepend": "^2.16.2",
        "phpmetrics/phpmetrics": "^2.9",
        "cmgmyr/phploc": "^8.0.6",
        "phpmd/phpmd": "^2.15"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
